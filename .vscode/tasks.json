{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AgroClima: instalar dependências",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/c",
        "instalar.bat --no-pause"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "AgroClima: verificar dependências",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "pip",
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
